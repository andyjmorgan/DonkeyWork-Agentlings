ANTHROPIC_API_KEY=sk-ant-...
AGENT_API_KEY=your-agent-api-key

# Path to agent definition YAML (name, description, tools, skills, system prompt)
# AGENT_CONFIG=./agent.yaml

# LLM wire format: messages (Anthropic Messages API) or responses (OpenAI Responses API)
# AGENT_WIRE_FORMAT=messages
# OPENAI_API_KEY=sk-...          # for AGENT_WIRE_FORMAT=responses
# OPENAI_BASE_URL=               # OpenAI-compatible /v1/responses endpoint override (host, .../v1, or full .../v1/responses)
# AGENT_SHARED_LLM_KEY=false     # explicit opt-in: reuse ANTHROPIC_API_KEY as the responses Bearer key
#                                # against a non-OpenAI gateway (openai.com hosts always refused)
# NOTE: AGENT_WIRE_FORMAT=responses requires AGENT_MODEL to be set explicitly
# (e.g. AGENT_MODEL=gpt-5-mini) — the default is a Messages-format Claude model.

# AGENT_MODEL=claude-sonnet-4-6
# AGENT_MAX_TOKENS=4096
# AGENT_HOST=0.0.0.0
# AGENT_PORT=8420
# AGENT_DATA_DIR=./data
# AGENT_LOG_LEVEL=INFO
# AGENT_LLM_BACKEND=anthropic
# AGENT_EXTERNAL_URL=
